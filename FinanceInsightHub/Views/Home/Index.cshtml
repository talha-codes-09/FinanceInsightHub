@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container py-5 text-center">
        <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3 fw-semibold">
            Smarter money management
        </span>

        <h1 class="display-4 fw-bold mb-3">
            Manage Your Finances <span class="text-gradient">Smarter</span>
        </h1>

        <p class="lead text-muted mx-auto" style="max-width: 640px;">
            Track your income and expenses, monitor savings goals,
            analyze spending habits, and gain valuable financial
            insights—all in one place.
        </p>

        <div class="mt-4 d-flex gap-3 justify-content-center flex-wrap">
            <a href="#" class="btn btn-primary btn-lg px-4 shadow-sm">
                Get Started
            </a>
            <a href="#" class="btn btn-outline-secondary btn-lg px-4">
                Learn More
            </a>
        </div>
    </div>
</div>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Features</h2>
            <p class="text-muted">
                Everything you need to manage your finances efficiently.
            </p>
        </div>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card border-0 rounded-4 h-100 reveal">
                    <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                        <div class="icon-circle bg-primary-subtle text-primary mb-3">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <h5 class="fw-bold">Expense Tracking</h5>
                        <p class="text-muted mb-0">
                            Track your daily income and expenses efficiently.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card border-0 rounded-4 h-100 reveal">
                    <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                        <div class="icon-circle bg-success-subtle text-success mb-3">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>
                        <h5 class="fw-bold">Financial Analytics</h5>
                        <p class="text-muted mb-0">
                            Visualize your financial data with interactive charts.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card border-0 rounded-4 h-100 reveal">
                    <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                        <div class="icon-circle bg-warning-subtle text-warning mb-3">
                            <i class="bi bi-bullseye"></i>
                        </div>
                        <h5 class="fw-bold">Savings Goals</h5>
                        <p class="text-muted mb-0">
                            Set and monitor your monthly savings targets.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card border-0 rounded-4 h-100 reveal">
                    <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                        <div class="icon-circle bg-danger-subtle text-danger mb-3">
                            <i class="bi bi-lightbulb"></i>
                        </div>
                        <h5 class="fw-bold">Budget Insights</h5>
                        <p class="text-muted mb-0">
                            Receive personalized recommendations to improve your budgeting.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5 text-center text-white">
    <div class="container">
        <h2 class="fw-bold mb-3">Ready to take control of your finances?</h2>
        <p class="mb-4 opacity-75">
            Join thousands of users already saving smarter with Finance Insight Hub.
        </p>
        <a href="#" class="btn btn-light btn-lg px-4 fw-semibold">
            Get Started for Free
        </a>
    </div>
</section>

<!-- Stats Section (moved to end of page) -->
<section class="py-5">
    <div class="container">
        <div class="stats-card reveal">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-0 stat-number" data-target="12" data-suffix="K+">0</h3>
                    <p class="text-muted small mb-0">Active users</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-0 stat-number" data-target="2.4" data-prefix="$" data-suffix="M">$0</h3>
                    <p class="text-muted small mb-0">Tracked monthly</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-0 stat-number" data-target="98" data-suffix="%">0</h3>
                    <p class="text-muted small mb-0">Goal success rate</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-0 stat-number" data-target="4.9" data-suffix="/5">0</h3>
                    <p class="text-muted small mb-0">Average rating</p>
                </div>
            </div>
        </div>
    </div>
</section>
