@model FinanceInsightHub.Models.SavingsGoal

@{
    ViewData["Title"] = "New Savings Goal";
}

<h2 class="fw-bold mb-4">New Savings Goal</h2>

<div class="card border-0 rounded-4 p-4 shadow-sm" style="max-width: 500px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold">Goal Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Emergency Fund" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TargetAmount" class="form-label fw-semibold">Target Amount <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="TargetAmount" class="form-control" placeholder="0.00" />
            </div>
            <span asp-validation-for="TargetAmount" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SavedAmount" class="form-label fw-semibold">Already Saved</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="SavedAmount" class="form-control" value="0" />
            </div>
            <span asp-validation-for="SavedAmount" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="TargetDate" class="form-label fw-semibold">Target Date (optional)</label>
            <input asp-for="TargetDate" class="form-control" type="date" />
        </div>

        <button type="submit" class="btn btn-primary px-4">Create Goal</button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}