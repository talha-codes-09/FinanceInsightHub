@model IEnumerable<FinanceInsightHub.Models.Transaction>

@{
    ViewData["Title"] = "Transactions";

    string SortLink(string column)
    {
        var newOrder = (ViewBag.SortBy == column && ViewBag.SortOrder == "asc") ? "desc" : "asc";
        return Url.Action("Index", new
        {
            searchTitle = ViewBag.SearchTitle,
            category = ViewBag.Category,
            type = ViewBag.Type,
            startDate = ViewBag.StartDate,
            endDate = ViewBag.EndDate,
            sortBy = column,
            sortOrder = newOrder,
            page = 1
        });
    }

    string SortIcon(string column)
    {
        if (ViewBag.SortBy != column) return "";
        return ViewBag.SortOrder == "asc" ? "▲" : "▼";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Transactions</h2>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">+ Add Transaction</a>
</div>

<!-- Filter bar -->
<div class="card border-0 rounded-4 p-4 shadow-sm mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Search Title</label>
            <input type="text" name="searchTitle" value="@ViewBag.SearchTitle" class="form-control" placeholder="e.g. Groceries" />
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-semibold">Category</label>
            <select name="category" class="form-select">
                <option value="">All</option>
                @foreach (var cat in new[] { "Salary", "Food", "Rent", "Utilities", "Entertainment", "Transport", "Other" })
                {
                    <option value="@cat" selected="@(ViewBag.Category == cat)">@cat</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-semibold">Type</label>
            <select name="type" class="form-select">
                <option value="">All</option>
                <option value="Income" selected="@(ViewBag.Type == "Income")">Income</option>
                <option value="Expense" selected="@(ViewBag.Type == "Expense")">Expense</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-semibold">From</label>
            <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-semibold">To</label>
            <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-1 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i>
            </button>
        </div>

        <div class="col-12">
            <a asp-action="Index" class="text-muted small text-decoration-none">
                <i class="bi bi-x-circle"></i> Clear all filters
            </a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th style="cursor:pointer" onclick="window.location='@SortLink("category")'">
                    Category @SortIcon("category")
                </th>
                <th>Type</th>
                <th style="cursor:pointer" onclick="window.location='@SortLink("date")'">
                    Date @SortIcon("date")
                </th>
                <th class="text-end" style="cursor:pointer" onclick="window.location='@SortLink("amount")'">
                    Amount @SortIcon("amount")
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Category</td>
                    <td>
                        <span class="badge rounded-pill @(item.Type == "Income" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                            @item.Type
                        </span>
                    </td>
                    <td>@item.Date.ToString("MMM dd, yyyy")</td>
                    <td class="text-end fw-semibold">@item.Amount.ToString("C")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted text-center py-4">No transactions match your filters.</p>
}

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new
                       {
                           searchTitle = ViewBag.SearchTitle,
                           category = ViewBag.Category,
                           type = ViewBag.Type,
                           startDate = ViewBag.StartDate,
                           endDate = ViewBag.EndDate,
                           sortBy = ViewBag.SortBy,
                           sortOrder = ViewBag.SortOrder,
                           page = i
                       })">@i</a>
                </li>
            }
        </ul>
    </nav>
}