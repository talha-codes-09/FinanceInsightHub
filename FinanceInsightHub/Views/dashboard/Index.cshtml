@model FinanceInsightHub.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">Here's your financial overview.</p>
    </div>
    <a asp-controller="Transactions" asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> Add Transaction
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 p-4 shadow-sm h-100 metric-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="icon-box bg-success-subtle text-success">
                    <i class="bi bi-arrow-down-left"></i>
                </div>
                @if (Model.IncomeChangePercent != 0)
                {
                    <span class="badge rounded-pill @(Model.IncomeChangePercent >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") small">
                        @(Model.IncomeChangePercent >= 0 ? "+" : "")@Model.IncomeChangePercent%
                    </span>
                }
            </div>
            <p class="text-muted small mb-1">Total Income</p>
            <h3 class="fw-bold mb-0">@Model.TotalIncome.ToString("C")</h3>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 p-4 shadow-sm h-100 metric-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="icon-box bg-danger-subtle text-danger">
                    <i class="bi bi-arrow-up-right"></i>
                </div>
                @if (Model.ExpenseChangePercent != 0)
                {
                    <span class="badge rounded-pill @(Model.ExpenseChangePercent <= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") small">
                        @(Model.ExpenseChangePercent >= 0 ? "+" : "")@Model.ExpenseChangePercent%
                    </span>
                }
            </div>
            <p class="text-muted small mb-1">Total Expenses</p>
            <h3 class="fw-bold mb-0">@Model.TotalExpenses.ToString("C")</h3>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 p-4 shadow-sm h-100 metric-card">
            <div class="icon-box bg-primary-subtle text-primary mb-3">
                <i class="bi bi-wallet2"></i>
            </div>
            <p class="text-muted small mb-1">Current Balance</p>
            <h3 class="fw-bold mb-0 @(Model.Balance >= 0 ? "text-primary" : "text-danger")">
                @Model.Balance.ToString("C")
            </h3>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 p-4 shadow-sm h-100 metric-card">
            <div class="icon-box bg-warning-subtle text-warning mb-3">
                <i class="bi bi-receipt"></i>
            </div>
            <p class="text-muted small mb-1">Transactions</p>
            <h3 class="fw-bold mb-0">@Model.TransactionCount</h3>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Category breakdown -->
    <div class="col-lg-5">
        <div class="card border-0 rounded-4 p-4 shadow-sm h-100">
            <h5 class="fw-bold mb-1">Top Spending</h5>
            <p class="text-muted small mb-4">
                @if (Model.TopCategory != "—")
                {
                    <text><strong>@Model.TopCategory</strong> is your biggest expense category at @Model.TopCategoryAmount.ToString("C").</text>
                }
                else
                {
                    <text>No expenses recorded yet.</text>
                }
            </p>

            @foreach (var cat in Model.CategoryBreakdown)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold small">@cat.Category</span>
                        <span class="text-muted small">@cat.Total.ToString("C")</span>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @cat.Percentage%; border-radius: 6px;"></div>
                    </div>
                </div>
            }

            @if (!Model.CategoryBreakdown.Any())
            {
                <p class="text-muted small">Add some expenses to see a breakdown here.</p>
            }
        </div>
    </div>

    <!-- Recent transactions -->
    <div class="col-lg-7">
        <div class="card border-0 rounded-4 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Transactions</h5>
                <a asp-controller="Transactions" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    View All
                </a>
            </div>

            @if (Model.RecentTransactions.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <tbody>
                            @foreach (var item in Model.RecentTransactions)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="icon-box-sm @(item.Type == "Income" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                <i class="bi @(item.Type == "Income" ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@item.Title</div>
                                                <div class="text-muted small">@item.Category · @item.Date.ToString("MMM dd")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold @(item.Type == "Income" ? "text-success" : "text-danger")">
                                        @(item.Type == "Income" ? "+" : "-")@item.Amount.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">
                    No transactions yet — <a asp-controller="Transactions" asp-action="Create">add your first one</a>.
                </p>
            }
        </div>
    </div>
</div>

<style>
    .metric-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .metric-card:hover {
            transform: translateY(-4px);
        }

    .icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .icon-box-sm {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }
</style>